{
  "$schema": "https://codecompanion.dev/schema/workspace.json",
  "name": "Pokedex",
  "description": "Open‑source Gen 1 Pokédex for Red, Blue & Yellow — hosted at pokedex.thedeadbeat.club",
  "tags": ["pokemon", "pokedex", "react", "typescript"],
  "include": [
    "src/**/*.{ts,tsx,js,jsx,css,json}",
    "public/**/*.json",
    "scripts/**/*.{ts,js}",
    "data/**/*.json",
    "package.json",
    "tsconfig.json"
  ],
  "exclude": ["node_modules", "dist", "build", ".git", "*.lock"],
  "entry": "src/app/page.tsx"
}
